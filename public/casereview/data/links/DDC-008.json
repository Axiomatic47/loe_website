{"doc_id":"DDC-008","file":"LINKS_DDC-008.tsv","header":["src_doc","src_page","text","n","kind","target_doc","target_page","target_page_end","target_pin","target_quote","status","by","note"],"rows":[{"src_doc":"DDC-008","src_page":"2","text":"Local Civil Rule 5.1","n":"1","kind":"rule","target_doc":"Local Rules AUG_2025","target_page":"23","target_page_end":"","target_pin":"LCvR 5.1","status":"mapped","target_quote":"(1) Absent statutory authority, no case or document may be sealed without an order from the Court. A document filed with the intention of it being sealed in an otherwise public case must be filed by electronic means in a manner authorized by the Clerk and shall be accompanied by a motion to seal. The document will be treated as sealed, pending the outcome of the ruling on the motion. Failure to file a motion to seal will result in the document being placed on the public record.","line":2,"k":1,"unit_id":"DDC-008-2-1-1-024cfd7d","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":2,"target_pdf_page":23,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"DDC-008","src_page":"3","text":"Hubbard v. EPA, 982 F.2d 531, 537 (D.C. Cir. 1992)","n":"1","kind":"case","target_doc":"","target_page":"","target_page_end":"","target_pin":"982 F.2d 531 at 537","status":"unresolved","target_quote":"","line":3,"k":1,"unit_id":"DDC-008-3-1-1-5dad754f","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_page":3,"target_pdf_page":null,"target_pdf_page_end":null,"target_known":false,"target_pin_page":null,"target_columns":null},{"src_doc":"DDC-008","src_page":"3","text":"In re Sealed Case, 237 F.3d 657, 665 (D.C. Cir. 2001)","n":"1","kind":"case","target_doc":"","target_page":"","target_page_end":"","target_pin":"237 F.3d 657 at 665","status":"unresolved","target_quote":"","line":4,"k":1,"unit_id":"DDC-008-3-1-1-0a32e14b","violations":[],"warnings":[],"target_ligature_drop":null,"src_pdf_p