{"doc_id":"DDC-073-02","file":"LINKS_DDC-073-02.tsv","header":["src_doc","src_page","text","n","kind","target_doc","target_page","target_page_end","target_pin","target_quote","status","by","note"],"rows":[{"src_doc":"DDC-073-02","src_page":"1","text":"28 U.S.C. § 1746","n":"1","kind":"statute","target_doc":"usc-28-chapter-115-evidence-documentary","target_page":"785","target_page_end":"786","target_pin":"§ 1746","status":"mapped","target_quote":"Wherever, under any law of the United States or under any rule, regulation, order, or requirement Subpoenas in multiparty, multiforum actions. 1785. Contempt. 1784. Subpoena of person in foreign country. 1783. Assistance to foreign and international tribunals and to litigants before such tribunals. 1782. Transmittal of letter rogatory or request. 1781. Sec. made pursuant to law, any matter is required or permitted to be supported, evidenced, established, or proved by the sworn declaration, verification, certificate, statement, oath, or affidavit, in writing of the person making the same (other than a deposition, or an oath of office, or an oath required to be taken before a specified official other than a notary public), such matter may, with like force and effect, be supported, evidenced, established, or proved by the unsworn declaration, certificate, verification, or statement, in writing of such person which is subscribed by him, as true under penalty of perjury, and dated, in substantially the following form: (1) If executed without the United States: \"I declare (or certify, verify, or state) under penalty of perjury under the laws of the United States of America that the foregoing is true and correct. Executed on (date). (Signature)\".","line":2,"k":1,"unit_id":"DDC-073-02-1-1-1-64a3e261","violations":[],"warnings":[],"target_ligature_drop":false,"src_pdf_page":1,"target_pdf_page":785,"target_pdf_page_end":786,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"DDC-073-02","src_page":"1","text":