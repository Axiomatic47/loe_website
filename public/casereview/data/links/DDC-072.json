{"doc_id":"DDC-072","file":"LINKS_DDC-072.tsv","header":["src_doc","src_page","text","n","kind","target_doc","target_page","target_page_end","target_pin","target_quote","status","by","note"],"rows":[{"src_doc":"DDC-072","src_page":"1","text":"Local Civil Rule 7(e)","n":"1","kind":"rule","target_doc":"Local Rules AUG_2025","target_page":"29","target_page_end":"","target_pin":"LCvR 7(e)","status":"verified","target_quote":"A memorandum of points and authorities in support of or in opposition to a motion shall not exceed 45 pages and a reply memorandum shall not exceed 25 pages, without prior approval of the Court. Documents that fail to comply with this provision shall not be filed by the Clerk.","line":2,"k":1,"unit_id":"DDC-072-1-1-1-efd2ac16","violations":[],"warnings":[],"src_pdf_page":1,"target_pdf_page":29,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":[]},{"src_doc":"DDC-072","src_page":"1","text":"ECF No. 69","n":"1","kind":"ecf","target_doc":"DDC-069","target_page":"1","target_page_end":"","target_pin":"ECF No. 69","status":"verified","target_quote":"","line":3,"k":1,"unit_id":"DDC-072-1-1-1-6eb0b688","violations":[],"warnings":[],"src_pdf_page":1,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"DDC-072","src_page":"1","text":"ECF No. 70","n":"1","kind":"ecf","target_doc":"DDC-070","target_page":"1","target_page_end":"","target_pin":"ECF No. 70","status":"verified","target_quote":"","line":4,"k":1,"unit_id":"DDC-072-1-1-1-777e72d0","violations":[],"warnings":[],"src_pdf_page":1,"target_pdf_page":1,"target_pdf_page_end":null,"target_known":true,"target_pin_page":null,"target_columns":null},{"src_doc":"DDC-072","src_page":"1","text":"§ II, infra","n":"1","kind":"internal","target_doc":"DDC-072","target_page":"2","target_page_end":"","target_pin":"§ II","status":"verified","target_quote":"","line":5,"k":1,"unit_id":"DDC-072-1-1-1-12bf6abb","violati