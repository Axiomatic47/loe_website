{
  "name": "laws-of-existence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A Unified Mathematical Framework for Consciousness, Ethics, and Reality",
  "author": "Joseph Kirchner",
  "keywords": [
    "consciousness",
    "mathematical-framework",
    "ethics",
    "philosophy",
    "unified-theory"
  ],
  "scripts": {
    "dev": "npm run process-testimonies-cms && vite",
    "start": "vite",
    "build": "npm run process-testimonies-cms && npm run generate-sitemap && tsc && vite build",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "sync-stac": "node scripts/sync-stac.mjs",
    "preview": "vite preview",
    "clean": "rimraf dist content/manuscript/* content/data/* public/uploads/*",
    "reset": "npm run clean && mkdir -p content/manuscript content/data public/uploads && chmod 777 content/manuscript content/data public/uploads",
    "cms": "npx netlify-cms-proxy-server --port 8083",
    "debug:content": "node scripts/content-debug.js",
    "create:test": "node scripts/content-debug.js --create-test",
    "dev:all": "concurrently \"npm run dev\" \"npm run cms\"",
    "process-testimonies-cms": "tsx scripts/processTestimoniesToCMS.ts",
    "cms-setup": "npm run process-testimonies-cms && echo 'Testimonies processed for CMS - check /admin'",
    "testimonies:count": "find testimonies -name '*.md' 2>/dev/null | wc -l || echo '0'",
    "testimonies:verify": "npm run process-testimonies-cms && echo 'CMS testimony processing completed successfully'",
    "testimonies:clean": "rimraf content/data/*testimony*.json public/uploads/data/*testimony*",
    "scotus:process": "tsx scripts/processSCOTUSCases.ts",
    "scotus:clean": "rimraf public/scotus-cases"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
