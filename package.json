{
  "name": "laws-of-existence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Laws of Existence — public legal-advocacy site (lawsofexistence.com)",
  "author": "Joseph Kirchner",
  "keywords": [
    "consciousness",
    "mathematical-framework",
    "ethics",
    "philosophy",
    "unified-theory"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-content && npm run generate-nav-manifest && npm run generate-sitemap && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "validate-content": "node scripts/validate-content.mjs",
    "generate-nav-manifest": "node scripts/generate-nav-manifest.mjs",
    "enrich-content-slugs": "node scripts/enrich-content-slugs.mjs",
    "freeze-legacy-urls": "node scripts/freeze-legacy-urls.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "sync-archives": "node scripts/sync-archives.mjs",
    "process-testimonies-cms": "tsx scripts/processTestimoniesToCMS.ts",
    "testimonies:count": "find testimonies -name '*.md' 2>/dev/null | wc -l || echo '0'",
    "scotus:process": "tsx scripts/processSCOTUSCases.ts",
    "scotus:clean": "rimraf public/scotus-cases"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.0",
    "dompurify": "^3.3.1",
    "file-saver": "^2.0.5",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.320.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sonner": "^1.3.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.7.0",
    "postcss": "^8.4.33",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5"
  }
